<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YA/TIDAK</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-blue-800 flex justify-center items-center h-screen">
    <div class="broder broder-2 broder-gray-700 bg-white p-4 rounded-md shadow-lg justify-center flex flex-col"
    >  
        <img
        id="gambar"
        class="rounded-md mb-3"
        src="https://media.tenor.com/3ykMgq-VYxEAAAAC/thinking.gif"
        width="450"
        alt=""/>
        <h1 class="font-bold text-slate-800 text-xl text-center" id="kalimat">Apakah kamu orangnya gampang kena prank?</h1>
        <div class="mt-3 text-white justify-center flex gap-4">
            <button 
            onclick="yaDitekan()" class="bg-green-700 px-4 py-1 rounded w-32">
            YA 
            </button>
            <button 
            id="tomboltidak"
            onclick="tidakditekan()" class="bg-red-700 px-4 py-1 rounded w-32">TIDAK</button>
        </div>
    </div>
    <script>
        let tomboltidak= document.getElementById("tomboltidak");
        let listKalimat = ["coba lagi", "udah jangan dipencet terus", "Bilang iya aja", "Mending nyerah", "Ga cape?", "KLIK YA!!!"];
        let kalimat= document.getElementById("kalimat");
        let gambar= document.getElementById("gambar");
        function yaDitekan() {
          kalimat.innerHTML = "prankk -cicil"; 
          gambar.src = "https://media.tenor.com/7hn-5MTUPrUAAAAi/cat-tongue-drawing-tiktok-gif.gif";
        }
        function tidakditekan() {
            kalimatRandom = Math.floor(Math.random() * listKalimat.length)
            kalimat.innerHTML = listKalimat [kalimatRandom];
            tomboltidak.style.position = "absolute";
            let angkaRandom = Math.floor(Math.random() * document.documentElement.clientWidth);
            let angkaRandom2 = Math.floor(Math.random() * document.documentElement.clientHeight);
            tomboltidak.style.left = angkaRandom + "px";
            tomboltidak.style.top = angkaRandom2 +  "px";
        }
    </script>   
</body>
</html>